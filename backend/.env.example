APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173

# postgresql database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openschool
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
# Pool sizing (defaults: max=25, min=5 — sized for a single school's daily
# traffic; raise DB_MAX_CONNS if Postgres logs connection-pool exhaustion
# under real load, but stay comfortably under Postgres's own
# max_connections, which defaults to 100)
# DB_MAX_CONNS=25
# DB_MIN_CONNS=5

# API-wide rate limit, per client IP (defaults: 30 req/s, burst 60 — see
# RateLimit in internal/middleware/ratelimit.go). Kept generous by default
# since a school's users are often behind one shared NAT/proxy IP.
# API_RATE_LIMIT_RPS=30
# API_RATE_LIMIT_BURST=60

# ThunderID Configs
THUNDERID_BASE_URL=
THUNDERID_TOKEN_URL=
THUNDERID_JWKS_URL=
THUNDERID_ISSUER=
THUNDERID_CLIENT_ID=
THUNDERID_CLIENT_SECRET=
THUNDERID_RESOURCE=
THUNDERID_OU_ID=
THUNDERID_ROLE_STUDENT=
THUNDERID_ROLE_TEACHER=
THUNDERID_ROLE_PARENT=
THUNDERID_ROLE_ADMIN=
