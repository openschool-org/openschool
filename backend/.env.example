APP_ENV=development
PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_NAME=openschool
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

IDP_PROVIDER=thunderid

THUNDERID_JWKS_URL=https://localhost:8090/oauth2/jwks
THUNDERID_ISSUER=https://localhost:8090
# Expected `aud` claim on end-user access tokens (the frontend SPA's OAuth
# client id — matches OPENSCHOOL_FRONTEND_CLIENT_ID in thunderid/environment.env).
# Optional: leave blank to skip audience validation.
THUNDERID_AUDIENCE=Audiance

THUNDERID_BASE_URL=https://localhost:8090
THUNDERID_OU_ID=01900000-0000-7000-8000-000000000001

THUNDERID_CLIENT_ID=N0000Dbx1111111169oUaA
# Filled in automatically by setup.sh - generated once, written here and into
# thunderid/environment.env with the same value. Never commit the real value.
THUNDERID_CLIENT_SECRET=
THUNDERID_TOKEN_URL=https://localhost:8090/oauth2/token

# Role IDs — fixed in thunderid/config.yml, identical on every fresh import.
THUNDERID_ROLE_STUDENT=11111111-0000-1111-0000-b3c1c6acb3f7
THUNDERID_ROLE_TEACHER=11111111-0000-1111-0000-b3c1c6acb3f7
THUNDERID_ROLE_ADMIN=11111111-0000-1111-0000-b3c1c6acb3f7
THUNDERID_ROLE_GUARDIAN=11111111-0000-1111-0000-b3c1c6acb3f7

THUNDERID_RESOURCE=https://localhost:8090/mcp

# Base URL of the frontend app — used to build links (e.g. password reset)
# that get emailed to users.
FRONTEND_URL=http://localhost:5173

# Outbound mail (used for password-reset links). If SMTP_HOST is left blank,
# emails are logged instead of sent — fine for local dev, not for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@openschool.local