APP_ENV=development
PORT=8080
CORS_ORIGINS=http://localhost:5173

# postgresql database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=openschool
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# Identity provider (asgardeo or thunderid)
IDP_PROVIDER=thunderid

# ThunderID Configs
THUNDERID_BASE_URL=
THUNDERID_TOKEN_URL=
THUNDERID_JWKS_URL=
THUNDERID_ISSUER=
THUNDERID_CLIENT_ID=
THUNDERID_CLIENT_SECRET=
THUNDERID_RESOURCE=
THUNDERID_OU_ID=
THUNDERID_ROLE_STUDENT=
THUNDERID_ROLE_TEACHER=
THUNDERID_ROLE_ADMIN=

# Asgardeo Configs
ASGARDEO_BASE_URL=https://api.asgardeo.io/t/<org-name>
ASGARDEO_TOKEN_URL=https://api.asgardeo.io/t/<org-name>/oauth2/token
ASGARDEO_JWKS_URL=https://api.asgardeo.io/t/<org-name>/oauth2/jwks
ASGARDEO_ISSUER=https://api.asgardeo.io/t/<org-name>/oauth2/token
ASGARDEO_CLIENT_ID=
ASGARDEO_CLIENT_SECRET=
ASGARDEO_ROLE_STUDENT=
ASGARDEO_ROLE_TEACHER=
ASGARDEO_ROLE_ADMIN=
