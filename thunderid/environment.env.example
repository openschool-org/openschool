# ThunderID declarative-import variables for OpenSchool local dev.
#
# These fill the {{.VAR}} placeholders in thunderid/config.yml at import time.
# Client IDs below are fixed dev-only values (safe to commit — they're not secrets).
# OPENSCHOOL_BACKEND_CLIENT_SECRET is intentionally blank here: setup.sh generates
# a random value and writes the real thunderid/environment.env (gitignored) with
# it filled in, then writes the same value into backend/.env.

CONSOLE_CLIENT_ID=CONSOLE
CONSOLE_REDIRECT_URIS=["https://localhost:8090/console"]

OPENSCHOOL_BACKEND_CLIENT_ID=NGHRhDbxXCCVBaUc69oUaA
OPENSCHOOL_BACKEND_CLIENT_SECRET=
OPENSCHOOL_BACKEND_REDIRECT_URIS=[]

OPENSCHOOL_FRONTEND_CLIENT_ID=gMCFica-956HT65qwczWkA
OPENSCHOOL_FRONTEND_REDIRECT_URIS=["http://localhost:5173"]